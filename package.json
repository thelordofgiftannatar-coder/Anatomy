{
  "name": "the-oath-keeper",
  "version": "1.0.0",
  "description": "Audiobook player that remembers where you stopped",
  "author": "The Oath Keeper",
  "main": "main.js",
  "scripts": { "start": "electron ." },
  "devDependencies": { "electron": "^33.2.0", "electron-builder": "^25.1.8" },
  "build": {
    "appId": "com.oathkeeper.player",
    "productName": "The Oath Keeper",
    "directories": { "buildResources": "build" },
    "files": ["main.js", "preload.js", "index.html", "cover.jpg", "icon.png"],
    "win": { "target": ["nsis", "portable"], "icon": "build/icon.ico" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "artifactName": "${productName}-Setup-${version}.${ext}" },
    "portable": { "artifactName": "${productName}-Portable-${version}.${ext}" }
  }
}
